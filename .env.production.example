# Copy values into Railway / Vercel dashboards (never commit real secrets).

# --- Railway: API + Worker + Beat (shared variables) ---
SECRET_KEY=generate-with-openssl-rand-hex-32
ENVIRONMENT=production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Set automatically when you add Postgres plugin on Railway:
# DATABASE_URL=postgresql://...

# Set automatically when you add Redis plugin:
# REDIS_URL=redis://...
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# Scraping — pick ONE approach:
# (A) Recommended: Redis + separate Railway service from deploy/railway-worker.toml (Celery worker).
# (B) Single API container only: set CELERY_TASK_ALWAYS_EAGER=true so scrape tasks run inside the API
#     process (no Redis). Long runs block one uvicorn worker; fine for demos / low traffic.
# CELERY_TASK_ALWAYS_EAGER=true

ANTHROPIC_API_KEY=sk-ant-...

# Your Vercel URL (after frontend deploy):
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=https://your-app.vercel.app

# Public API URL (Railway → API service → Settings → Networking):
API_URL=https://your-api.up.railway.app

# LinkedIn (optional) — redirect must match production API host:
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://your-api.up.railway.app/api/v1/auth/linkedin/callback

# Stripe (Railway API — same vars on API service)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_PREMIUM=price_...
# STRIPE_PRICE_ID_PRO=
# Optional: comma-separated Checkout payment_method_types (default card,link on API).
# STRIPE_CHECKOUT_PAYMENT_METHOD_TYPES=card,link

# Investor / calculator “Live aggregates” + dashboard feed headline (optional)
# INVESTOR_MVP_STATS_DEMO_MODE=true
# INVESTOR_MVP_STATS_DEMO_VALIDATED_JOBS=100000
# INVESTOR_MVP_STATS_DEMO_FORCE_INTEGRATIONS_ON=true

# Authologic KYC (optional — Customer API on API service)
# AUTHOLOGIC_API_BASE_URL=https://sandbox.authologic.com
# AUTHOLOGIC_API_LOGIN=
# AUTHOLOGIC_API_KEY=
# AUTHOLOGIC_STRATEGY=public:default
# AUTHOLOGIC_SERVER_PUBLIC_URL=https://your-api.up.railway.app
# AUTHOLOGIC_CALLBACK_TOKEN=

# --- Vercel: Frontend only ---
NEXT_PUBLIC_API_URL=https://your-api.up.railway.app
