# Copy values into Railway / Vercel dashboards (never commit real secrets).

# --- Railway: API + Worker + Beat (shared variables) ---
SECRET_KEY=generate-with-openssl-rand-hex-32
ENVIRONMENT=production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Set automatically when you add Postgres plugin on Railway:
# DATABASE_URL=postgresql://...

# Set automatically when you add Redis plugin:
# REDIS_URL=redis://...
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

ANTHROPIC_API_KEY=sk-ant-...

# Your Vercel URL (after frontend deploy):
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=https://your-app.vercel.app

# Public API URL (Railway → API service → Settings → Networking):
API_URL=https://your-api.up.railway.app

# LinkedIn (optional) — redirect must match production API host:
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://your-api.up.railway.app/api/v1/auth/linkedin/callback

# --- Vercel: Frontend only ---
NEXT_PUBLIC_API_URL=https://your-api.up.railway.app
