# Stripe secret key (test: sk_test_..., live: sk_live_...)
# Prefer a restricted API key (rk_...) scoped to Checkout + webhooks only.
STRIPE_SECRET_KEY=sk_test_your_key_here

# Webhook signing secret from Dashboard or `stripe listen --forward-to localhost:4242/webhook`
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Optional: pin API version (defaults to SDK default if unset)
# STRIPE_API_VERSION=2026-04-22.dahlia

# Public URL of this app (no trailing slash)
APP_URL=http://localhost:4242

# Port for the HTTP server
PORT=4242
