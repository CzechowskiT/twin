# Database
DATABASE_URL=postgresql+psycopg://twin:twin@localhost:5433/twin_dev

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Auth (generate: openssl rand -hex 32)
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
FRONTEND_URL=http://localhost:3000

# LinkedIn OAuth — required for “Continue with LinkedIn” (see docs/LINKEDIN_KONFIGURACJA_PL.md)
# Sign In with LinkedIn using OpenID Connect. See docs/LINKEDIN_OAUTH.md
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/linkedin/callback

# Google OAuth (OpenID Connect) — redirect must match exactly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# GitHub OAuth — scope read:user user:email
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Apple Sign in with Apple (Services ID + .p8 key). Private key: PEM or single line with \\n escapes.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/apple/callback

# Microsoft Entra (stub — not wired yet; leave unset)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback

# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# App
ENVIRONMENT=development
# Comma-separated. Must include every browser origin that calls the API directly (e.g. your Vercel production URL when NEXT_PUBLIC_API_URL points at Railway).
CORS_ORIGINS=http://localhost:3000
API_URL=http://localhost:8000

# Auto-apply (Phase 2 — local Mac with visible browser for CAPTCHA)
AUTO_APPLY_HEADLESS=false
AUTO_APPLY_SUBMIT=false
AUTO_APPLY_DEFAULT_PHONE=
AUTO_APPLY_STATE_DIR=data/browser_state

# Frontend (Next.js)
# Server-side API proxy (`app/api/v1/...`) forwards to this URL. On Vercel use full Railway URL with https:// (host alone is auto-fixed in code, but prefer full URL).
# When set on Vercel: the browser calls Railway directly for requests that send `Authorization` (avoids Vercel dropping that header on dynamic `/api` routes). Unauthenticated calls still use the same-origin proxy. Railway `CORS_ORIGINS` must include your Vercel origin (e.g. https://twin-sooty.vercel.app).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Job-board scrape chips + “scrape all” (default off — set true for local dev)
# NEXT_PUBLIC_SHOW_SCRAPE=true

# Scraping: comma-separated board ids from the scraper registry (same as GET /api/v1/jobs/boards).
# Leave empty to run all boards on “auto scrap”. Example: pracuj-sales,rocketjobs-sales,linkedin
SCRAPE_ENABLED_BOARD_IDS=

# Voice intro upload (see POST /api/v1/candidates/me/intro-audio). Transcription is Phase 2.
INTRO_AUDIO_UPLOAD_DIR=data/intro_audio
INTRO_AUDIO_MAX_BYTES=15728640
