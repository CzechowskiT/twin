# Database
DATABASE_URL=postgresql+psycopg://twin:twin@localhost:5433/twin_dev

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Run Celery tasks inside the API process (no Redis broker). Local/solo-host only; use a real worker in prod.
# CELERY_TASK_ALWAYS_EAGER=true

# Auth (generate: openssl rand -hex 32)
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Auth rate limits: SlowAPI enforces 5 requests/minute per client IP on POST /auth/register, /auth/login,
# /auth/login/json, and /auth/forgot-password (independent counters per path).
# Optional legacy env knobs (see app.services.login_rate_limit) may still apply to other code paths.
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=0
# Optional: max POST /auth/forgot-password per client IP per rolling minute (0 = disabled; default 5 in code).
AUTH_FORGOT_PASSWORD_RATE_LIMIT_PER_MINUTE=0
FRONTEND_URL=http://localhost:3000
# Public API base (OAuth calendar callbacks, WebCal). When GOOGLE_CALENDAR_REDIRECT_URI is unset, derived from this.
API_URL=http://localhost:8000

# LinkedIn OAuth (see docs/LINKEDIN_KONFIGURACJA_PL.md)
# Sign In with LinkedIn using OpenID Connect. See docs/LINKEDIN_OAUTH.md
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/linkedin/callback
# Optional: LinkedIn Jobs scrape (Playwright). geoId sharpens location (e.g. 105072130 = Poland).
# LINKEDIN_JOBS_GEO_ID=105072130
# Set false only locally to debug login walls (not for headless servers).
# LINKEDIN_JOBS_BROWSER_HEADLESS=true

# Google OAuth (OpenID Connect) — redirect must match exactly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Same OAuth client: add this URI in Google Cloud Console for Calendar (read busy + create events).
# Optional if API_URL is set. For Next.js dev proxy also whitelist:
# http://localhost:3000/api/v1/calendar/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/calendar/google/callback

# Microsoft Entra ID (Azure app registration) — sign-in + calendar (same app)
# See docs/MICROSOFT_AZURE_PL.md
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback
MICROSOFT_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/calendar/microsoft/callback
# common | organizations | consumers | your-tenant-id
MICROSOFT_TENANT=common

# GitHub OAuth — scope read:user user:email
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Apple Sign in with Apple (Services ID + .p8 key). Private key: PEM or single line with \\n escapes.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/apple/callback

# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# App
ENVIRONMENT=development
# When false, GET /api/v1/geo/jurisdiction-hint returns OTHER without outbound IP/geo lookups (air-gapped / strict privacy).
# GEO_JURISDICTION_LOOKUP_ENABLED=true
# Comma-separated. Must include every browser origin that calls the API directly (e.g. your Vercel production URL when NEXT_PUBLIC_API_URL points at Railway).
CORS_ORIGINS=http://localhost:3000
API_URL=http://localhost:8000
# Optional: GET /api/v1/health returns git_commit (Railway RAILWAY_GIT_COMMIT_SHA, Vercel VERCEL_GIT_COMMIT_SHA, or GIT_COMMIT_SHA)
# GIT_COMMIT_SHA=

# Auto-apply (Phase 2 — local Mac with visible browser for CAPTCHA)
AUTO_APPLY_HEADLESS=false
# Default true: click final submit when the form is filled. Set false for dry-run (review in browser only).
AUTO_APPLY_SUBMIT=true
AUTO_APPLY_DEFAULT_PHONE=
AUTO_APPLY_STATE_DIR=data/browser_state
# When true (default), build one PDF: tailored pitch + consent + verbatim CV text, and attach it instead of the raw file.
AUTO_APPLY_TAILORED_PDF=true
# Optional path to a Unicode TTF (defaults to backend/assets/fonts/NotoSans-Regular.ttf).
# AUTO_APPLY_FONT_PATH=
# Optional extra Polish consent paragraphs (separate blocks with a blank line).
# AUTO_APPLY_CONSENT_EXTRA_PL=
# Set true to return 403 on Free tier for POST /applications/auto-apply (default false = all plans, for investor demos).
# AUTO_APPLY_REQUIRE_PREMIUM=false
# Optional caps / guardrails (0 = disabled). Company blocklists are comma-separated case-insensitive substrings.
# AUTO_APPLY_DAILY_MAX_PER_USER=0
# AUTO_APPLY_COMPANY_COOLDOWN_HOURS=0
# AUTO_APPLY_COMPANY_BLOCKLIST=
# AUTO_APPLY_TITLE_BLOCKLIST=
# Per-user per-minute cap using Redis (0 = off). Uses REDIS_URL.
# AUTO_APPLY_RATE_LIMIT_PER_MINUTE=0
# When true, POST /applications/auto-apply requires JSON human_acknowledged=true.
# AUTO_APPLY_REQUIRE_HUMAN_ACK=false
# Outbound JSON webhook after successful auto-apply (HMAC optional).
# EMPLOYER_WEBHOOK_URL=
# EMPLOYER_WEBHOOK_SECRET=
# Partner CSV export: GET /api/v1/partner/exports/applications-recent.csv with header X-Twin-Partner-Token
# PARTNER_EXPORT_TOKEN=

# Stripe (subscriptions — Checkout: configure rails via STRIPE_CHECKOUT_PAYMENT_METHOD_TYPES, default card+Link; wallets ride on card)
# Webhook URL: POST https://<api-host>/api/v1/billing/webhook (see docs/STRIPE.md)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Phase 2 micro-tiers (monthly Price ids from Stripe Dashboard)
STRIPE_PRICE_ID_STANDBY=
STRIPE_PRICE_ID_STANDARD=
STRIPE_PRICE_ID_PREMIUM=
# Optional top tier (leave empty until a Price exists in Stripe)
STRIPE_PRICE_ID_PRO=
# Comma-separated Stripe Checkout payment_method_types for subscriptions (default: card,link).
# Apple Pay / Google Pay are not separate values — they appear with `card` when enabled.
# STRIPE_CHECKOUT_PAYMENT_METHOD_TYPES=card,link

# Greenhouse ATS webhook HMAC secret (optional). POST /api/v1/integrations/ats/greenhouse
# GREENHOUSE_WEBHOOK_SECRET=
# Greenhouse Harvest partner OAuth (authorization code). Callback: GET /api/v1/integrations/ats/greenhouse/callback
# GREENHOUSE_CLIENT_ID=
# GREENHOUSE_CLIENT_SECRET=
# GREENHOUSE_OAUTH_REDIRECT_URI=https://<api-host>/api/v1/integrations/ats/greenhouse/callback
# GREENHOUSE_OAUTH_SCOPES=
# LEVER_CLIENT_ID=
# LEVER_CLIENT_SECRET=
# LEVER_OAUTH_REDIRECT_URI=https://<api-host>/api/v1/integrations/ats/lever/callback

# Investor demo seed (scripts/seed-investor-demo.py) — never commit real passwords
# DEMO_USER_EMAIL=demo@twin.career
# DEMO_USER_PASSWORD=
# INVESTOR_DEMO_EMAIL=   # legacy alias for DEMO_USER_EMAIL
# INVESTOR_DEMO_PASSWORD=

# S3-compatible storage (optional; investor data room presigned PUT when bucket is set).
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=twin-artifacts
# S3_REGION=auto

# When true, matching uses v2 salary-overlap bonus on top of v1 rules.
# MATCH_SCORING_V2=false

# Authologic KYC (Customer API v1.1 — https://developer.authologic.com)
# Basic auth: OmniPanel username + API key as password. Sandbox base is the default.
AUTHOLOGIC_API_BASE_URL=https://sandbox.authologic.com
AUTHOLOGIC_API_LOGIN=
AUTHOLOGIC_API_KEY=
# Strategy id from Authologic (e.g. public:default or your tenant strategy from OmniPanel).
AUTHOLOGIC_STRATEGY=public:default
# Public URL of this API (https://...) so CreateConversation can include callbackUrl; Authologic then calls it with placeholders expanded.
AUTHOLOGIC_SERVER_PUBLIC_URL=
# Optional shared secret: when set, /api/v1/kyc/authologic/callback requires ?t=<same value>.
AUTHOLOGIC_CALLBACK_TOKEN=

# Frontend (Next.js)
# Server-side API proxy (`app/api/v1/...`) forwards to this URL. On Vercel use full Railway URL with https:// (host alone is auto-fixed in code, but prefer full URL).
# When set on Vercel: the browser calls Railway directly for requests that send `Authorization` (avoids Vercel dropping that header on dynamic `/api` routes). Unauthenticated calls still use the same-origin proxy. Railway `CORS_ORIGINS` must include your Vercel origin (e.g. https://twin-sooty.vercel.app).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Dashboard “Twin for your job” scrape panel: on by default. Set to "false" on Vercel to hide.
# NEXT_PUBLIC_SHOW_SCRAPE=false
# Optional: YouTube video id for /first-1000 manifesto embed (privacy-enhanced nocookie player).
# NEXT_PUBLIC_LAUNCH_MANIFESTO_YOUTUBE_ID=

# Celery + scrape worker (Railway: Redis plugin → CELERY_BROKER_URL / CELERY_RESULT_BACKEND)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=true
# Set true on API after twin-worker is deployed (non-eager mode).
# SCRAPE_WORKER_READY=false

# Optional ops allowlist — tags scrape_ops_elevated on /auth/me (does not block other users).
# SCRAPE_OPS_EMAILS=you@company.com
# SCRAPE_OPS_USER_IDS=1

# Scraping: comma-separated board ids (must exist in registry). Filters /jobs/boards and scrape-all.
# Implemented ids include:
#   pracuj, pracuj-sales, rocketjobs, rocketjobs-sales, rocketjobs-roles, justjoin, praca,
#   linkedin, linkedin-sales, indeed-pl, indeed, glassdoor, monster, ziprecruiter, careerbuilder,
#   simplyhired, jooble, reed, stepstone, seek
# Leave empty = all boards (slow). MVP-friendly example (Poland + Indeed PL + optional LinkedIn):
#   SCRAPE_ENABLED_BOARD_IDS=pracuj,rocketjobs,indeed-pl
# For a robots-clean demo, omit linkedin* (see docs/SCRAPING_COMPLIANCE.md).
# SCRAPE_ENABLED_BOARD_IDS=pracuj-sales,rocketjobs-sales,justjoin,praca,indeed,glassdoor
SCRAPE_ENABLED_BOARD_IDS=
# Per-board cap when running Twin scrape-all (each adapter clamps to this).
SCRAPE_JOBS_PER_BOARD=200
# JOB_FEED_ACTIVE_DAYS=45
# When >0, skip saving rows where len(requirements)+len(description) is below this (default 0 = keep listing-only).
# SCRAPE_MIN_JOB_BODY_CHARS=0
# Daily scrape-all via Celery Beat (requires `celery -A app.tasks.celery_app beat` alongside worker).
# Manual POST /jobs/scrape/all from dashboard (off by default — autonomous beat only).
# SCRAPE_USER_TRIGGER_ENABLED=false
# SCRAPE_BEAT_ENABLED=false
# Autonomous beat windows (worker + beat process). Legacy single scrape-all:
# SCRAPE_BEAT_LEGACY_SCRAPE_ALL=false
# SCRAPE_BEAT_PL_HOUR_UTC=4
# SCRAPE_BEAT_GREENHOUSE_HOUR_UTC=5
# SCRAPE_BEAT_GLOBAL_HOUR_UTC=3
# SCRAPE_BEAT_LINKEDIN_HOUR_UTC=6
# LINKEDIN_SCRAPE_MAX_PER_RUN=25
# MARKET_COVERAGE_TARGET_JOBS=10000
# Hour UTC (0–23) when legacy scrape-all runs (if SCRAPE_BEAT_LEGACY_SCRAPE_ALL=true).
# SCRAPE_BEAT_HOUR_UTC=5
# Max jobs scanned per candidate match (newest validated first).
# MATCH_JOBS_SCAN_LIMIT=15000
# Honour robots.txt before Playwright fetches (default true). LinkedIn robots disallow generic bots entirely.
# SCRAPE_RESPECT_ROBOTS_TXT=true
# Serial pause between boards in scrape-all (seconds).
# SCRAPE_BETWEEN_BOARDS_SEC=1.5
# Optional throttle after each fetch_html session (seconds; 0 = off).
# SCRAPE_POST_FETCH_DELAY_SEC=0

# Voice intro upload (see POST /api/v1/candidates/me/intro-audio). Transcription is Phase 2.
INTRO_AUDIO_UPLOAD_DIR=data/intro_audio
INTRO_AUDIO_MAX_BYTES=15728640

# Beta waitlist (`/beta`, `/api/v1/beta/*`). Set the same `BETA_ADMIN_TOKEN` on Vercel for `/api/beta-admin/stats`.
# BETA_WAITLIST_CAP=1000
# BETA_CAMPAIGN_ENDS_AT=2026-06-01T00:00:00+00:00
# BETA_ADMIN_TOKEN=openssl-rand-hex-32
# BETA_UPLOAD_DIR=data/beta_waitlist
# BETA_UPLOAD_MAX_BYTES=15728640

# Investor no-login preview (GET /api/v1/demo/snapshot — 404 when false)
# DEMO_MODE_ENABLED=false
# DEMO_USER_EMAIL=demo@twin.career
# Seed script password (never commit): DEMO_USER_PASSWORD or INVESTOR_DEMO_PASSWORD
