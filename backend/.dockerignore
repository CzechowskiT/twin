# Python / tooling caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
*.egg-info/
.eggs/
dist/
build/

# Local virtualenv (often hundreds of MB — must never be in the build context)
.venv/
venv/
env/

# Secrets & local env
.env
.env.*
!.env.example

# Local DB / state
*.db
*.sqlite3
celerybeat-schedule
celerybeat-schedule-shm
celerybeat-schedule-wal

# Runtime uploads / browser state (recreated in production)
data/
intro_audio/

# Tests not needed in the API image
tests/

# VCS / editor
.git/
.gitignore
.idea/
.vscode/

# Docs
*.md

# Playwright browser download cache from dev machines (image runs `playwright install` itself)
ms-playwright/
