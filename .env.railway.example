# Copy to .env.railway (gitignored) and fill secrets, then:
#   npx @railway/cli login
#   npx @railway/cli link   # pick project + API service "twin"
#   ./scripts/railway-apply-production-env.sh

# Production API host (from Railway → Networking → Generate Domain)
RAILWAY_API_URL=https://twin-production-bcd9.up.railway.app

# Waitlist / transactional mail (Resend — https://resend.com/api-keys)
# MAIL_FROM must use a domain you verified in Resend (or Resend onboarding address).
RESEND_API_KEY=
MAIL_FROM=TWIN <onboarding@resend.dev>

# Alternative: SMTP instead of Resend (leave RESEND_API_KEY empty)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=TWIN <noreply@example.com>

# Google Calendar (Google Cloud Console → APIs & Services → Credentials → OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://twin-production-bcd9.up.railway.app/api/v1/calendar/google/callback

# Microsoft 365 Calendar (Azure Portal → App registrations)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALENDAR_REDIRECT_URI=https://twin-production-bcd9.up.railway.app/api/v1/calendar/microsoft/callback
MICROSOFT_TENANT=common
