# Copy to .env.railway (gitignored) and fill secrets, then:
#   ./scripts/apply-prod-autonomous.sh
# Or: npx @railway/cli login && npx @railway/cli link && ./scripts/railway-apply-production-env.sh
#
# Non-interactive CLI: Railway → Account → Tokens → add RAILWAY_TOKEN below.
# Vercel → Account → Tokens → VERCEL_TOKEN (optional, for ./scripts/vercel-apply-production-env.sh).
RAILWAY_TOKEN=
VERCEL_TOKEN=

# Production API host (from Railway → Networking → Generate Domain)
RAILWAY_API_URL=https://twin-production-bcd9.up.railway.app

# Waitlist / transactional mail (Resend — https://resend.com/api-keys)
# MAIL_FROM must use a domain you verified in Resend (or Resend onboarding address).
RESEND_API_KEY=
MAIL_FROM=TWIN <onboarding@resend.dev>

# Alternative: SMTP instead of Resend (leave RESEND_API_KEY empty)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=TWIN <noreply@example.com>

# Google sign-in + calendar (Google Cloud Console → APIs & Services → Credentials → OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://twin-production-bcd9.up.railway.app/api/v1/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=https://twin-production-bcd9.up.railway.app/api/v1/calendar/google/callback

# GitHub sign-in (GitHub → Settings → Developer settings → OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://twin-production-bcd9.up.railway.app/api/v1/auth/github/callback

# Apple Sign in with Apple (Apple Developer → Certificates, Identifiers & Profiles)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=https://twin-production-bcd9.up.railway.app/api/v1/auth/apple/callback

# Microsoft sign-in + calendar (Azure Portal → App registrations)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://twin-production-bcd9.up.railway.app/api/v1/auth/microsoft/callback
MICROSOFT_CALENDAR_REDIRECT_URI=https://twin-production-bcd9.up.railway.app/api/v1/calendar/microsoft/callback
MICROSOFT_TENANT=common

# 4 — Celery worker + beat (Redis plugin in Railway; worker: deploy/railway-worker.toml with --beat)
# Use Railway reference syntax when applying via dashboard Raw Editor:
CELERY_BROKER_URL=${{Redis.REDIS_URL}}
CELERY_RESULT_BACKEND=${{Redis.REDIS_URL}}
CELERY_TASK_ALWAYS_EAGER=false
SCRAPE_WORKER_READY=true
SCRAPE_BEAT_ENABLED=true
AUTO_APPLY_HEADLESS=true

# LinkedIn OAuth (Sign in with LinkedIn — callback on API, not frontend)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://twin-production-bcd9.up.railway.app/api/v1/auth/linkedin/callback

# 5 — Stripe (test: python3 scripts/stripe-bootstrap-test.py → paste output here)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STANDBY=
STRIPE_PRICE_ID_STANDARD=
STRIPE_PRICE_STANDBY=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_ID_PREMIUM=
STRIPE_PRICE_ID_PRO=

# Ops / integrators / recruiter pilot (run scripts/generate-deploy-secrets.sh)
OPS_ADMIN_TOKEN=
BETA_ADMIN_TOKEN=
RECRUITER_INBOX_TOKEN=
PARTNER_EXPORT_TOKEN=

# TWIN Agent Dispatcher (Cursor Cloud Agents) — see docs/agent-dispatcher/
# Production secret name (service-account API key from Cursor Dashboard):
CURSOR_CLOUD_AGENTS_API_KEY=
AGENT_DISPATCH_TOKEN=
# Optional: AGENT_DISPATCH_TOKENS=token1:agent_runs:create|agent_runs:read,token2:agent_runs:admin
AGENT_DISPATCH_WEBHOOK_SECRET=
AGENT_DISPATCH_WEBHOOK_PUBLIC_URL=
# Optional GitHub token for PR/SHA/CI enrichment (repo scope)
AGENT_DISPATCH_GITHUB_TOKEN=
AGENT_DISPATCH_REPO_ALLOWLIST=https://github.com/CzechowskiT/twin
AGENT_DISPATCH_BASE_BRANCH_ALLOWLIST=cursor/phase1-monorepo-scaffold

# Investor data room S3 (Cloudflare R2 or AWS — see docs/RAILWAY_PROD_ENV_CHECKLIST.md)
# When all three core vars are set, ./scripts/railway-apply-production-env.sh disables local demo uploads.
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_REGION=auto
DATA_ROOM_LOCAL_UPLOAD_ENABLED=true

# Prod DB seed scripts (Postgres service → Connect → Public URL; not the API service DATABASE_URL)
DATABASE_PUBLIC_URL=
